# Environment variables the app reads. On Render, set them in the dashboard; never commit real values.
APP_ENV=production            # "production" turns on secure cookies and real-client-IP logging
APP_DEMO=1                    # 0 hides the demo credentials shown on sign-in pages

DB_HOST=gateway01.xxxxxxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxx.root
DB_PASS=
DB_NAME=bankingmanagementsystem
DB_SSL=1                      # hosted MySQL requires TLS
# DB_SSL_VERIFY=0             # only if the provider's certificate chain cannot be verified

# Used only by scripts/db_init.php: set a private master-admin password instead of the public demo one
# MASTER_ADMIN_PASSWORD=
